APP_NAME="Comanda Fácil"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
INERTIA_DEVTOOLS_ENABLED=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=comanda_facil
DB_USERNAME=comanda_facil
DB_PASSWORD=

# Opcional: iniciar cluster de desenvolvimento existente antes de serve/dev.
# Mantenha false ao usar PostgreSQL como serviço, Docker ou servidor externo.
LOCAL_POSTGRES_MANAGED=false
LOCAL_POSTGRES_BIN=
LOCAL_POSTGRES_DATA=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gere credenciais locais antes de iniciar o Reverb; não reutilize estes exemplos em produção.
REVERB_APP_ID=local-comanda-facil
REVERB_APP_KEY=replace-with-local-key
REVERB_APP_SECRET=replace-with-local-secret
REVERB_SERVER_HOST=127.0.0.1
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Se navegador e emissor usam endereços diferentes (LAN/proxy), configure estes valores públicos.
# REVERB_PUBLIC_HOST=restaurante.exemplo.com
# REVERB_PUBLIC_PORT=443
# REVERB_PUBLIC_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
